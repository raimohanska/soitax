{
  "name": "soitax",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/soitax",
  "remoteUser": "pwuser",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "containerEnv": {
    "TZ": "Europe/Helsinki"
  },
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  // Runs on the host before the container is created. The opencode config dir
  // is gitignored (absent on a fresh clone) and ~/.gitconfig may not exist;
  // without this, Docker creates the missing bind sources itself, as
  // root-owned dirs - which breaks git and opencode.
  "initializeCommand": "mkdir -p .devcontainer/opencode && touch -a $HOME/.gitconfig",
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [8099],
  "portsAttributes": {
    "8099": { "label": "Soitax dev server" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-playwright.playwright"]
    }
  }
}
